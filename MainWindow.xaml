<Window x:Class="CrashLens.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CrashLens — Windows crash intelligence" Width="1330" Height="835"
        MinWidth="1060" MinHeight="680" WindowStartupLocation="CenterScreen"
        Background="#081522" Foreground="#F0F8FF" FontFamily="Segoe UI"
        Icon="Assets/CrashLens.ico" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8DA8BF"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8DA8BF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F0F8FF"/>
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="FlatSideButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#10283C"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#DCEBF8"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#173B54"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#112237"/>
            <Setter Property="BorderBrush" Value="#233C50"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Height" Value="54"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1A344B"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#173B54"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#152C40"/>
            <Setter Property="Foreground" Value="#AFC5D6"/>
            <Setter Property="Height" Value="41"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="218"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left rail -->
        <Border Grid.Column="0" Background="#0C1C2C" BorderBrush="#23394B" BorderThickness="0,0,1,0">
            <Grid Margin="22,22,22,19">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#18354B" CornerRadius="13" Width="56" Height="56">
                        <Image Source="Assets/CrashLensLogo.png" Width="47" Height="47" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Margin="10,4,0,0">
                        <TextBlock Text="CrashLens" Foreground="White" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="WINDOWS DIAGNOSTICS" Foreground="#54D9FF" FontSize="8" FontWeight="Bold" Margin="1,4,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,43,0,0">
                    <TextBlock Text="РАБОЧЕЕ ПРОСТРАНСТВО" Style="{StaticResource SectionLabel}" Margin="5,0,0,15"/>
                    <Border Background="#143449" CornerRadius="9" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Fill="#45DBFF" Width="7" Height="7" Margin="0,5,10,0"/>
                            <TextBlock Text="Обзор событий" Foreground="#E6F9FF" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <Button Content="↻  Обновить журнал" Style="{StaticResource FlatSideButton}" Click="RefreshButton_Click"/>
                    <Button Content="▤  Экспорт в CSV" Style="{StaticResource FlatSideButton}" Click="ExportButton_Click"/>
                    <Button Content="◫  Папка с данными" Style="{StaticResource FlatSideButton}" Click="OpenDataFolder_Click"/>
                    <Button Content="▣  Журнал Windows" Style="{StaticResource FlatSideButton}" Click="OpenEventViewer_Click"/>
                    <Button Content="▧  Дампы памяти" Style="{StaticResource FlatSideButton}" Click="OpenDumpFolder_Click"/>
                </StackPanel>
                <StackPanel Grid.Row="3">
                    <Border Background="#10293C" BorderBrush="#25485E" BorderThickness="1" CornerRadius="12" Padding="13,14" Margin="0,0,0,18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                                <Ellipse Width="8" Height="8" Fill="#66E0BD" Margin="0,4,8,0"/>
                                <TextBlock Text="Системный монитор" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="Отслеживание событий без постоянного сканирования процессов" Foreground="#91B1C5" FontSize="11" TextWrapping="Wrap" LineHeight="17"/>
                        </StackPanel>
                    </Border>
                    <CheckBox x:Name="AutoStartCheck" Content="Автозапуск с Windows" Foreground="#BFD4E5" FontSize="11"
                              Margin="0,0,0,13" Checked="AutoStart_Changed" Unchecked="AutoStart_Changed"/>
                    <CheckBox x:Name="NotificationsCheck" Content="Уведомления о сбоях" Foreground="#BFD4E5" FontSize="11"
                              Margin="0,0,0,22" Checked="Notifications_Changed" Unchecked="Notifications_Changed"/>
                    <TextBlock Text="CrashLens by Nikita Batalov" Foreground="#6B8AA0" FontSize="10" Margin="0,0,0,4"/>
                    <TextBlock Text="VERSION 1.0  ·  LOCAL FIRST" Foreground="#55768E" FontSize="9"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Column="1" Margin="25,23,25,19">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="КОМАНДНЫЙ ЦЕНТР" Foreground="#52D9FF" FontWeight="SemiBold" FontSize="10" Margin="1,0,0,6"/>
                    <TextBlock Text="Обзор стабильности Windows" Foreground="#F4F9FF" FontSize="27" FontWeight="Bold"/>
                    <TextBlock Text="Падения приложений, системные ошибки и синие экраны — в одном месте." Foreground="#8EABBF" FontSize="12" Margin="1,8,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#102D3C" BorderBrush="#21566B" BorderThickness="1" CornerRadius="12" Padding="13,10" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="MonitorDot" Fill="#6BE0BB" Width="8" Height="8" Margin="0,4,9,0"/>
                        <TextBlock Text="LIVE MONITORING" Foreground="#BCECDD" FontWeight="Bold" FontSize="10"/>
                    </StackPanel>
                </Border>
            </Grid>
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,24,0,24">
                <Border Background="#11273A" BorderBrush="#254357" BorderThickness="1" CornerRadius="13" Margin="0,0,8,0" Padding="17,15">
                    <StackPanel>
                        <TextBlock Text="ВСЕГО СОБЫТИЙ" Style="{StaticResource SectionLabel}"/>
                        <TextBlock x:Name="TotalCountText" Text="0" Style="{StaticResource StatValue}" Margin="0,5,0,2"/>
                        <TextBlock Text="В локальной истории" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                </Border>
                <Border Background="#11273A" BorderBrush="#254357" BorderThickness="1" CornerRadius="13" Margin="4,0,4,0" Padding="17,15">
                    <StackPanel>
                        <TextBlock Text="КРИТИЧЕСКИЕ" Style="{StaticResource SectionLabel}"/>
                        <TextBlock x:Name="CriticalCountText" Text="0" Style="{StaticResource StatValue}" Foreground="#FF97A9" Margin="0,5,0,2"/>
                        <TextBlock Text="Системные инциденты" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                </Border>
                <Border Background="#11273A" BorderBrush="#254357" BorderThickness="1" CornerRadius="13" Margin="4,0,4,0" Padding="17,15">
                    <StackPanel>
                        <TextBlock Text="BSOD / BUGCHECK" Style="{StaticResource SectionLabel}"/>
                        <TextBlock x:Name="BsodCountText" Text="0" Style="{StaticResource StatValue}" Foreground="#51DDFF" Margin="0,5,0,2"/>
                        <TextBlock Text="Подтверждённые события" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                </Border>
                <Border Background="#11273A" BorderBrush="#254357" BorderThickness="1" CornerRadius="13" Margin="8,0,0,0" Padding="17,15">
                    <StackPanel>
                        <TextBlock Text="ПОСЛЕДНИЕ 7 ДНЕЙ" Style="{StaticResource SectionLabel}"/>
                        <TextBlock x:Name="WeekCountText" Text="0" Style="{StaticResource StatValue}" Margin="0,5,0,2"/>
                        <TextBlock Text="Записей за неделю" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
            <Grid Grid.Row="2" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="158"/>
                    <ColumnDefinition Width="141"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Margin="0,0,12,0" TextChanged="Filter_Changed" ToolTip="Поиск по коду, источнику, описанию, категории..."/>
                <ComboBox x:Name="PeriodCombo" Grid.Column="1" Margin="0,0,12,0" SelectedIndex="0" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="Всё время" Tag="all"/>
                    <ComboBoxItem Content="Сегодня" Tag="day"/>
                    <ComboBoxItem Content="7 дней" Tag="week"/>
                    <ComboBoxItem Content="30 дней" Tag="month"/>
                    <ComboBoxItem Content="1 год" Tag="year"/>
                </ComboBox>
                <ComboBox x:Name="SeverityCombo" Grid.Column="2" SelectedIndex="0" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="Все уровни" Tag="all"/>
                    <ComboBoxItem Content="Критично" Tag="Critical"/>
                    <ComboBoxItem Content="Ошибки" Tag="Error"/>
                    <ComboBoxItem Content="Предупр." Tag="Warning"/>
                </ComboBox>
            </Grid>
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="400"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#112237" BorderBrush="#254357" BorderThickness="1" CornerRadius="13" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="16,14,16,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ЛЕНТА СОБЫТИЙ" FontWeight="Bold" Foreground="#D8ECFB" FontSize="12"/>
                            <TextBlock Grid.Column="1" x:Name="ListCountText" Text="0 записей" Foreground="#87A9C0" FontSize="11"/>
                        </Grid>
                        <DataGrid Grid.Row="1" x:Name="EventsGrid" ItemsSource="{Binding VisibleEvents}"
                                  SelectionChanged="EventsGrid_SelectionChanged" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                                  HeadersVisibility="Column" SelectionUnit="FullRow" SelectionMode="Single"
                                  GridLinesVisibility="None" RowHeaderWidth="0" BorderThickness="0"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                  Background="#112237" AlternationCount="0" FontSize="11">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ДАТА / ВРЕМЯ" Binding="{Binding TimeLabel}" Width="142"/>
                                <DataGridTemplateColumn Header="УРОВЕНЬ" Width="92">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding SeverityBackground}" CornerRadius="6" Padding="7,4" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding SeverityLabel}" Foreground="{Binding SeverityForeground}" FontWeight="Bold" FontSize="10"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="СОБЫТИЕ" Binding="{Binding Title}" Width="*" MinWidth="130"/>
                                <DataGridTextColumn Header="КОД" Binding="{Binding CodeLabel}" Width="105"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Background="#112237" BorderBrush="#254357" BorderThickness="1" CornerRadius="13">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="17,15">
                        <StackPanel>
                            <TextBlock Text="АНАЛИЗ ИНЦИДЕНТА" Foreground="#8EABBF" FontSize="11" FontWeight="Bold" Margin="0,0,0,15"/>
                            <Border Background="#143347" CornerRadius="11" Padding="12,12" Margin="0,0,0,13">
                                <StackPanel>
                                    <TextBlock x:Name="DetailCategoryText" Text="Выберите событие" Foreground="#51DAFF" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock x:Name="DetailCodeText" Text="—" Foreground="#F1FAFF" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" Margin="0,6,0,3"/>
                                    <TextBlock x:Name="DetailTitleText" Text="Здесь появятся подробности" Foreground="#B4CDE0" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="ЧТО ЭТО ЗНАЧИТ" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                            <TextBlock x:Name="DetailExplanationText" Text="Выберите запись в журнале слева, чтобы увидеть код, объяснение и источник." TextWrapping="Wrap"
                                       Foreground="#D0DFEA" FontSize="12" LineHeight="19" Margin="0,0,0,18"/>
                            <TextBlock Text="ИСТОЧНИК" Style="{StaticResource SectionLabel}" Margin="0,0,0,5"/>
                            <TextBlock x:Name="DetailSourceText" Text="—" TextWrapping="Wrap" FontSize="11" Foreground="#D6E9F5" Margin="0,0,0,14"/>
                            <TextBlock Text="ВРЕМЯ И ЗАПИСЬ" Style="{StaticResource SectionLabel}" Margin="0,0,0,5"/>
                            <TextBlock x:Name="DetailTimestampText" Text="—" TextWrapping="Wrap" FontSize="11" Foreground="#D6E9F5" Margin="0,0,0,15"/>
                            <Button x:Name="GoogleButton" Content="↗  Поиск ошибки в Google" Background="#17607C" BorderBrush="#2489AA"
                                    Foreground="#E8FAFF" Margin="0,0,0,9" Click="GoogleButton_Click" IsEnabled="False"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <Button x:Name="CopyButton" Content="Скопировать" IsEnabled="False" Click="CopyButton_Click" Margin="0,0,8,0"/>
                                <Button x:Name="DumpButton" Content="Открыть дамп" IsEnabled="False" Click="DumpButton_Click"/>
                            </StackPanel>
                            <Expander Header="Сообщение Windows и XML" Foreground="#A7C7DB" FontSize="11">
                                <StackPanel Margin="0,10,0,5">
                                    <TextBlock x:Name="DetailMessageText" Text="—" TextWrapping="Wrap" Foreground="#C9DFEC" FontSize="11" Margin="0,0,0,13"/>
                                    <TextBox x:Name="XmlTextBox" IsReadOnly="True" Text="" AcceptsReturn="True" TextWrapping="NoWrap"
                                             FontFamily="Consolas" FontSize="10" MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
            <Grid Grid.Row="4" Margin="3,13,3,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="MonitorStatusText" Text="Инициализация мониторинга..." Foreground="#91B4C8" FontSize="10" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="ЛОКАЛЬНО • БЕЗ ТЕЛЕМЕТРИИ" Foreground="#6989A0" FontSize="10" FontWeight="SemiBold"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
